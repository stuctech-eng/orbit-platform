# Firebase Admin SDK credentials — instellen als Environment Variables in Vercel
# (Project Settings > Environment Variables), NIET committen met echte waarden.
#
# Te vinden via: Firebase Console > Project Settings > Service accounts
# > Generate new private key (levert een JSON-bestand met deze 3 velden)

FIREBASE_PROJECT_ID=jouw-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jouw-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
